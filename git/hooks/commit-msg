#!/usr/bin/env bash
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$hook_dir/../policy.sh"

branch_name="$(git branch --show-current)"
prefix="${GIT_TICKET_PREFIX:-$(git config --get ticket.prefix 2>/dev/null || printf 'SHOP')}"
commit_message="$(cat "$1")"
new_message="$(rewrite_commit_message "$branch_name" "$prefix" "$commit_message")"

if [[ "$new_message" != "$commit_message" ]]; then
  printf '%s\n' "$new_message" > "$1"
fi
