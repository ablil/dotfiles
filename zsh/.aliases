#!/bin/sh

alias doc="cd ~/Documents"
alias dl="cd ~/Downloads"
alias dt="cd ~/Desktop"
alias l="ls -l -a"
alias la="ls -a"
alias ll="ls -l"
alias dc="docker compose"
alias dps="docker ps"
alias dpsa="docker ps -a"
alias gclnf="git clean -fd"
alias rmr="rm -r"
alias yt=yt-dlp
alias igrep='grep -i'
alias esed='sed -E'
alias gcp="gcloud"
alias tf="terraform"
alias gdl="./gradlew"
alias gstam="git stash push -m"
alias conf="gcloud config configurations activate"
alias dls='docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Ports}}\t{{.Status}}"'

# macos specific aliases
if [[ $OSTYPE == darwin* ]]; then
    (( $+commands[gsed] )) && alias sed=gsed
    alias clip="pbcopy"
    alias o="open"
else
    (( $+commands[xclip] )) && alias clip="xclip -selection clipboard"
    alias o="xdg-open"
fi
