#!/bin/zsh

# touch but for nested files
function mkfile() {
  [[ -n $1 ]] || return 1
  [[ -d ${1:h} ]] || command mkdir -p ${1:h}
  touch "$1"
}

function _fzf_files() {
  typeset -ga reply
  local IFS=$'\n'
  reply=($(fzf-tmux --query="$1" --multi --select-1 --exit-0))
  (( ${#reply} ))
}

# vi - vi a file, including hidden directories
function vif() {
  _fzf_files "$1" && ${EDITOR:-vim} "${reply[@]}"
}

# f - get a file
function f() {
  _fzf_files "$1" && print -r -- "${reply[@]}"
}

# cd - cd to directory, including hidden directories
function cdf() {
  local dir
  dir=$(fd --type d --hidden --exclude .git 2>/dev/null | fzf +m) && cd "$dir"
}

# historyf - repeat history
function historyf() {
  local cmd
  cmd=$(fc -l 1 | fzf +s --tac | sed -E 's/ *[0-9]*\*? *//') && eval "$cmd"
}

# gswf - checkout git branch
function gswf() {
  local branch
  branch=$(git --no-pager branch --format='%(refname:short)' | fzf +m) && git checkout "$branch"
}

# gclnb - delete branches already merged into HEAD
function gclnb() {
  local current branches
  [[ -n ${1:-} ]] && current=$1 || current=$(git rev-parse --abbrev-ref HEAD)
  branches=$(git branch --format='%(refname:short)' --merged |
    grep -vxE '^(master|main|dev|develop)$' | grep -vxF -- "$current")
  [[ -n $branches ]] || return 0
  local -a to_delete
  to_delete=(${(f)branches})
  git branch -d "${to_delete[@]}"
}

# gsh - git show
function gshf() {
  git log --graph --color=always \
      --format="%C(auto)%h%d %s %C(black)%C(bold)%cr" "$@" |
  fzf --ansi --no-sort --reverse --tiebreak=index --bind=ctrl-s:toggle-sort \
      --bind "ctrl-m:execute:
                (grep -o '[a-f0-9]\{7\}' | head -1 |
                xargs -I % sh -c 'git show --color=always % | less -R') << 'FZF-EOF'
                {}
FZF-EOF"
}

# vid - open all files inside directory
function vid() {
    local -a files
    files=(${(f)"$(git ls-files; git ls-files --others --exclude-standard)"})
    (( ${#files} )) && ${EDITOR:-vim} "${files[@]}"
}

function wipe() {
    local shred arg
    if (( $+commands[gshred] )); then
        shred=gshred
    elif (( $+commands[shred] )); then
        shred=shred
    else
        print -u2 "wipe: shred not found (brew install coreutils)"
        return 1
    fi
    for arg in "$@"; do
        if [[ -f $arg ]]; then
            command $shred -zvu "$arg"
        elif [[ -d $arg ]]; then
            find "$arg" -type f -exec $shred -zvu {} + && command rm -rf "$arg"
        fi
    done
}

# open a directory under $HOME/repos
function repo() {
    local dir
    dir=$(fd --type d --max-depth 1 . "$HOME/repos" | fzf +m) && cd "$dir"
}

function curlj() {
    curl -sS -H 'Accept: application/json' "$@" | jq
}

function curlh() {
    curl -sS -o /dev/null -D - "$@"
}

function curlcode() {
    curl -sS -o /dev/null -w '%{http_code}\n' "$@"
}
